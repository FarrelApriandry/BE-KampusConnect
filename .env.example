NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=replace-me-with-64-hex-chars
JWT_EXPIRES_IN=7d
ALLOWED_CAMPUS_DOMAINS=untidar.ac.id,students.untidar.ac.id
CORS_ORIGIN=*
# Akun ini di-seed via database/seeds/002_admin.sql (password default: Admin123!).
# Variabel di bawah hanya dokumentasi, tidak dipakai kode.
ADMIN_EMAIL=admin@untidar.ac.id
